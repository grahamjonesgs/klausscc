// v2 round-trip fixture: 3-operand ALU + stack round-trip. Prints "0".
// Computes 0x10 + 0x20 = 0x30 ('0'), pushes/pops it, then transmits it.
_start
SETR B 0xF0010000    // UART TX_DATA
SETR C 0x10
SETR D 0x20
ADDR A C D           // A = C + D = 0x30 (rd, rs1, rs2)
PUSH A               // round-trip through the stack
POP A
MEMSET8 A B          // transmit 0x30 = '0'
HALT
