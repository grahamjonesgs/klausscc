// Test 11: Step sequence
// Prints the step numbers 1 to 10 over the UART (with $TXR, through the MMIO
// routines in uart_stubs.kla), pausing with DELAYV after each, then HALTs.
// Step 10 also prints C, which nothing sets, so its value is whatever C
// holds at that point.
// This was the v1 LED, 7-segment, RGB and switch test. Those devices are now
// memory-mapped and this file does not drive them; it lists no expected
// values, so the test runners skip it.

_start
DELAYV 0x0500
$NEWLINE

// Step 1
SETR A 0x1
$TXR A
$NEWLINE
DELAYV 0xFFFF

// Step 2
SETR A 0x2
$TXR A
$NEWLINE
DELAYV 0xFFFF

// Step 3
SETR A 0x3
$TXR A
$NEWLINE
DELAYV 0xFFFF

// Step 4
SETR A 0x4
$TXR A
$NEWLINE
DELAYV 0xFFFF

// Step 5
SETR A 0x5
$TXR A
$NEWLINE
DELAYV 0xFFFF

// Step 6
SETR A 0x6
$TXR A
$NEWLINE
DELAYV 0xFFFF

// Step 7
SETR A 0x7
$TXR A
$NEWLINE
DELAYV 0xFFFF

// Step 8
SETR A 0x8
$TXR A
$NEWLINE
DELAYV 0xFFFF

// Step 9
SETR A 0x9
$TXR A
$NEWLINE
DELAYV 0xFFFF

// Step 10
SETR A 0xA
$TXR A
$NEWLINE
$TXR C
$NEWLINE
DELAYV 0xFFFF

HALT

// v2 MMIO UART output helpers ($TXR / $NEWLINE / $TXSTR / $TXMEMCHAR)
!include uart_stubs.kla
