// Test 23: Emulator-vs-hardware alignment
// One board run (-T) of this file checks that the emulator and the CPU agree
// on every behaviour the emulator was recently changed to match the RTL:
//   a) AND/OR/XOR write no flags         g) unaligned 64-bit access with A=0
//   b) MUL family Z/S/V                  h) BEXTR reads rs1[63:32]; BDEP
//   c) DIV/MOD flags, divide by zero,       zero-extends
//      INT_MIN / -1                      i) .S imm8 forms at their boundaries
//   d) ABSR of INT_MIN                   j) #name strings: $TXSTR and byte loads
//   e) ROLR/RORR by a register count of  k) code after inline data that the
//      1 vs ROLR1/RORR1                     assembler pads to 8 bytes
//   f) F-bit Z writes on unary ops
//
// Flag lines: PFLAGS prints 0000ZSCV, one hex digit per flag (Z, S, C, V),
// each 0 or 1. It reads Z, C and V with GETF (SETFR) and S with a branch,
// before any instruction that writes flags. Before each checked op the flags
// are set to a known state with PRE_Z (Z=1 S=0 C=0 V=0) or PRE_SC
// (Z=0 S=1 C=1 V=0), so a flag the op does not write shows its old value.
// "high" lines print bits [63:32] of the result (D >> 32).
//
// The derivation of every value from the RTL (KlaussCPU master,
// KlaussCPU.srcs/sources_1/new/pipeline_core.sv, "pc:NNN" below) is in the
// comments by each check, so it can be checked without the emulator.
// Flags commit at WB (pc:1543); Z is (result == 0) for every Z writer here
// (pc:1549-1550, 1917).
//
// Expected UART output:
//   00001000  a1 ANDR after Z=1: flags (Z kept)
//   00000030  a1 ANDR result
//   00000110  a2 XORR to 0 after Z=0: flags (Z not set)
//   00000000  a2 XORR result
//   00001000  a3 ORR after Z=1: flags
//   000000FF  a3 ORR result
//   00001000  a4 XORV after Z=1: flags
//   000000F0  a4 XORV result
//   00001011  b1 MULR 2^32*2^32: flags (Z=1 V=1, C kept)
//   00000000  b1 MULR result
//   00000010  b2 MULHR after a V=1 MULR: flags (V cleared)
//   00000001  b2 MULHR result
//   00000101  b3 MULUR -1*2: flags (S=1 V=1)
//   FFFFFFFE  b3 MULUR result
//   00000000  b4 MULHUR after a V=1 MULUR: flags
//   00000001  b4 MULHUR result
//   00000101  b5 MULV 2^62*3: flags (S=1 V=1)
//   C0000000  b5 MULV result high
//   00000100  b6 MULR -1*2 after V=1: flags (V cleared)
//   FFFFFFFE  b6 MULR result
//   00000010  c1 DIVR 100/7 after Z=1 V=1: flags
//   0000000E  c1 DIVR result
//   00001110  c2 MODR 21%7: flags (Z=1)
//   00000000  c2 MODR result
//   00001001  c3 DIVR 100/0 after Z=1: flags (Z kept, V=1)
//   FFFFFFFF  c3 DIVR by zero result
//   FFFFFFFF  c3 DIVR by zero result high
//   00000111  c4 MODR 0%0 after Z=0: flags (Z kept, V=1)
//   00000000  c4 MODR by zero result
//   00000064  c5 MODUR 100%0 result (the dividend)
//   00000110  c6 DIVR INT_MIN/-1 after V=1: flags
//   80000000  c6 DIVR result high
//   00000000  c6 DIVR result
//   00001110  c7 MODR INT_MIN%-1: flags
//   00000000  c7 MODR result
//   00000111  d1 ABSR INT_MIN: flags (V=1)
//   80000000  d1 ABSR result high
//   00000000  d2 ABSR -5 after V=1: flags
//   00000005  d2 ABSR result
//   00000110  e1 ROLR by register 1: flags (C kept)
//   00000002  e1 ROLR result
//   00000110  e2 RORR by register 1: flags (C kept)
//   00000001  e2 RORR result
//   00000100  e3 ROLR1: flags (C = old bit 63)
//   00000002  e3 ROLR1 result
//   00000010  e4 RORR1: flags (C = old bit 0)
//   80000000  e4 RORR1 result high
//   00001110  e5 ROLR of 0 by register: flags (Z written)
//   00000000  e5 ROLR result
//   00000110  f1 COPY of 0 (no F): flags (Z kept)
//   00001110  f2 NEGR 0: flags (Z only)
//   00000000  f3 NOTR 0 after Z=1: flags (Z cleared, S kept)
//   FFFFFFFF  f3 NOTR result
//   00000100  f4 SEXTB 0x80: flags (S written)
//   FFFFFF80  f4 SEXTB result
//   00000010  f5 SEXTH 0x17FFF: flags (S written 0)
//   00007FFF  f5 SEXTH result
//   00001110  f6 ZEXTB 0x100: flags
//   00000000  f6 ZEXTB result
//   00000000  f7 ZEXTH -1 after Z=1: flags
//   0000FFFF  f7 ZEXTH result
//   00001110  f8 POPCNT 0: flags
//   00001000  f9 CLZ 0 (no F) after Z=1: flags
//   00000040  f9 CLZ result
//   00000101  f10 INCR 0x7FFF...F: flags (all four written)
//   80000000  f10 INCR result high
//   44444444  g1 LDIDX64 at buf+0x0C reads buf+0x08: low
//   33333333  g1 high
//   88888888  g2 MEMSET64RR to buf+0x14 wrote buf+0x10: low
//   77777777  g2 high
//   66666666  g2 buf+0x18 unchanged: low
//   55555555  g2 buf+0x18 unchanged: high
//   22222222  g3 MEMREADRR at buf+0x04 reads buf+0x00: low
//   00000000  h1 BEXTR after Z=1: flags (Z written 0)
//   00000A50  h1 BEXTR start 28 len 12 of 0xA5_0000_0000
//   00001110  h2 BEXTR to 0 after Z=0: flags (Z written 1)
//   00001000  h3 BDEP after Z=1: flags (no flags written)
//   FFFFF00F  h3 BDEP result
//   00000000  h3 BDEP result high (zero-extended)
//   B0000000  h4 BDEP field past bit 31
//   00000000  h4 BDEP result high
//   FFFFFF80  i1 SETR.S -128
//   FFFFFFFF  i1 SETR.S -128 high
//   0000007F  i2 SETR.S 127
//   000000FF  i3 ANDV.S 255 of -1
//   00000000  i3 high (zero-extended)
//   00001234  i4 XORV.S 0
//   00000080  i5 ADDI.S 0x100 + -128
//   0000017F  i5 ADDI.S 0x100 + 127
//   00000001  i6 MINUSV.S 0x100 - 255
//   00000100  i6 ADDV.S 1 + 255
//   00001000  i7 CMPRV.S -128 with -128: flags
//   00000100  i8 CMPRV.S -128 with 127: flags
//   C0FFEE42  j1 #HWSTR printed with $TXSTR
//   00000043  j2 MEMGET8 of byte 0 ('C')
//   00000032  j3 LDIDX8 of byte 7 ('2')
//   00000000  j3 LDIDX8 of byte 8 (the NUL)
//   46463043  j4 MEMGET32 of bytes 0-3, little-endian
//   1D1EC0DE  k1 inline #KDATA printed by the code after it
//   00000018  k1 #KDATA - LEAPC address: 20 code bytes + the 4-byte pad
//   00000000  k1 #KDATA address mod 8
//   00000000  k1 K_RESUME address mod 8

_start
DELAYV 0x0500
$NEWLINE

// ===== a) AND/OR/XOR write no flags ========================================
// RTL: class 1/2 ALU ops 4-6 (AND/OR/XOR, register and immediate) decode
// with no fmask (pc:413-415); only ADD/SUB/ADC/SBC set fmask='1 (pc:409-411).
// PRE_Z/PRE_SC: CMP is SUB with fmask='1 and no writeback (pc:449-452),
// C = sum[64] (borrow), S = sum[63], V per pc:1016.

// a1: Z=1, then ANDR gives 0xF0 & 0x3C = 0x30 (pc:1007). Flags stay Z=1.
SETR B 0xF0
SETR C 0x3C
CALL PRE_Z:
ANDR D B C
CALL PFLAGS:
$TXR D
$NEWLINE

// a2: Z=0 S=1 C=1, then XORR B B = 0 (pc:1009). A Z writer would set Z;
// AND/OR/XOR do not, so the flags stay 0110.
SETR B 0x5A
CALL PRE_SC:
XORR D B B
CALL PFLAGS:
$TXR D
$NEWLINE

// a3: Z=1, then ORR 0xF0 | 0x0F = 0xFF (pc:1008). Flags stay 1000.
SETR B 0xF0
SETR C 0x0F
CALL PRE_Z:
ORR D B C
CALL PFLAGS:
$TXR D
$NEWLINE

// a4: the immediate form (class 2, same decode, pc:413). 0xFF ^ 0x0F = 0xF0.
SETR D 0xFF
CALL PRE_Z:
XORV D 0x0F
CALL PFLAGS:
$TXR D
$NEWLINE

// ===== b) MUL family: Z, S, V written; C kept ==============================
// RTL: MUL decodes fmask Z,S,V (pc:655-658). mul_a_q/mul_b_q are the operands
// sign-extended to 65 bits for MULR/MULHR/MULV and zero-extended for
// MULUR/MULHUR (mduns = !op[23], pc:647, 896-898). Result = product[63:0],
// or [127:64] for the H forms (pc:1158); S = result[63] (pc:1159); V = 0
// for the H forms (pc:1160), else product[127:64] != 0 (unsigned, pc:1161)
// or != 64 copies of product[63] (signed, pc:1162).

// b1: MULR 2^32 * 2^32 = 2^64: low 0, high 1. V = (1 != 0) = 1, S = 0,
// Z = 1. C kept 1 from PRE_SC: 1011.
SETR64 B 0x0000000100000000
COPY C B
CALL PRE_SC:
MULR D B C
CALL PFLAGS:
$TXR D
$NEWLINE

// b2: the same MULR (V=1, Z=1) then MULHR: result = high half = 1, V = 0,
// S = 0, Z = 0; C kept 1: 0010.
CALL PRE_SC:
MULR E B C
MULHR D B C
CALL PFLAGS:
$TXR D
$NEWLINE

// b3: MULUR (-1) * 2, unsigned: 0xFFFF_FFFF_FFFF_FFFF * 2 = 2^65 - 2.
// Low = 0xFFFF_FFFF_FFFF_FFFE, high = 1 != 0, so V = 1; S = 1; Z = 0;
// C kept 0 from PRE_Z: 0101. (SETR sign-extends its imm32, pc:959.)
SETR B -1
SETR C 2
CALL PRE_Z:
MULUR D B C
CALL PFLAGS:
$TXR D
$NEWLINE

// b4: the same MULUR (V=1) then MULHUR: result = high half = 1, V = 0,
// S = 0, Z = 0, C kept 0: 0000.
CALL PRE_Z:
MULUR E B C
MULHUR D B C
CALL PFLAGS:
$TXR D
$NEWLINE

// b5: MULV takes a signed imm32 (op[23] = SGN set, pc:647). 2^62 * 3 =
// 0xC000_0000_0000_0000: high = 0 but low[63] = 1, so the signed product
// does not fit: V = 1. S = 1, Z = 0, C kept 0: 0101. High word C0000000.
SETR64 D 0x4000000000000000
CALL PRE_Z:
MULV D 3
CALL PFLAGS:
CALL TXHI:

// b6: MULUR -1*2 sets V (b3), then signed MULR -1*2 = -2: high = all ones =
// 64 copies of low[63], so V = 0. S = 1, Z = 0, C kept 0: 0100.
SETR B -1
SETR C 2
CALL PRE_Z:
MULUR E B C
MULR D B C
CALL PFLAGS:
$TXR D
$NEWLINE

// ===== c) DIV/MOD ==========================================================
// RTL: DIV and MOD decode fmask Z,V (pc:659-666). A non-zero divisor gives
// V = 0 (pc:1174) and Z from the result. Divide by zero (pc:913,
// 1165-1169): result = dividend for MOD, all ones for DIV, and fmask is cut
// to V alone with V = 1, so Z is kept. Signed divide works on magnitudes
// (w_div_abs_a/b, pc:923-924, latched at pc:1579) and negates the result
// by sign_q = a[63]^b[63] or sign_r = a[63] (pc:1581-1582, 1171-1173).

// c1: MULR 2^32*2^32 sets Z=1 V=1 (S=0, C kept 1 from PRE_SC); DIVR 100/7 =
// 14 writes Z = 0, V = 0: 0010.
SETR64 E 0x0000000100000000
SETR B 100
SETR C 7
CALL PRE_SC:
MULR F E E
DIVR D B C
CALL PFLAGS:
$TXR D
$NEWLINE

// c2: MODR 21 % 7 = 0: Z = 1, V = 0; S, C kept from PRE_SC: 1110.
SETR B 21
SETR C 7
CALL PRE_SC:
MODR D B C
CALL PFLAGS:
$TXR D
$NEWLINE

// c3: Z=1 (PRE_Z), DIVR 100 / 0 = all ones; only V written (1): 1001.
SETR B 100
SETR C 0
CALL PRE_Z:
DIVR D B C
CALL PFLAGS:
$TXR D
$NEWLINE
CALL TXHI:

// c4: Z=0 (PRE_SC), MODR 0 % 0 = the dividend 0. A Z write would set Z;
// it is kept 0. V = 1: 0111.
SETR B 0
SETR C 0
CALL PRE_SC:
MODR D B C
CALL PFLAGS:
$TXR D
$NEWLINE

// c5: MODUR 100 % 0 = the dividend, 100 = 0x64.
SETR B 100
SETR C 0
MODUR D B C
$TXR D
$NEWLINE

// c6: INT_MIN / -1. A divide by zero sets V = 1 first (Z kept 0 from
// PRE_SC). |INT_MIN| = 0x8000_0000_0000_0000 (pc:923, ~a + 1 of INT_MIN is
// itself), |-1| = 1, quotient 0x8000_0000_0000_0000; sign_q = 1 ^ 1 = 0, so
// no negation: INT_MIN, no trap. Z = 0, V = 0, S/C kept 1: 0110.
SETR64 B 0x8000000000000000
SETR C -1
SETR F 0
CALL PRE_SC:
DIVR E B F
DIVR D B C
CALL PFLAGS:
CALL TXHI:
$TXR D
$NEWLINE

// c7: INT_MIN % -1: remainder 0, sign_r = 1 negates 0 to 0. Z = 1, V = 0:
// 1110.
CALL PRE_SC:
MODR D B C
CALL PFLAGS:
$TXR D
$NEWLINE

// ===== d) ABSR =============================================================
// RTL: ABS needs F and decodes fmask Z,V (pc:520-522). Result = a[63] ?
// -a : a; V = (a == 0x8000_0000_0000_0000) (pc:1060-1063).

// d1: ABSR INT_MIN = INT_MIN, V = 1, Z = 0; S, C kept 1 from PRE_SC: 0111.
SETR64 D 0x8000000000000000
CALL PRE_SC:
ABSR D
CALL PFLAGS:
CALL TXHI:

// d2: ABSR INT_MIN sets V = 1, then ABSR -5 = 5 clears it; Z = 0, S/C kept
// 0 from PRE_Z: 0000.
SETR64 E 0x8000000000000000
SETR D -5
CALL PRE_Z:
ABSR E
ABSR D
CALL PFLAGS:
$TXR D
$NEWLINE

// ===== e) Rotates ==========================================================
// RTL (pc:467-475): ROL/ROR is U_ROT1 (fmask Z and C, C = the bit rotated
// out, pc:1048-1049) only for SRC=1 N=1 F=1, which is ROLR1/RORR1. ROLR and
// RORR (SRC=0, count from rs2[5:0], pc:964) are U_SHIFT and write only Z
// (F is set in their template).

// e1: ROLR 1 by C=1 = 2. ROLR1 would set C = old bit 63 = 0; ROLR keeps
// PRE_SC's C = 1: 0110.
SETR D 1
SETR C 1
CALL PRE_SC:
ROLR D D C
CALL PFLAGS:
$TXR D
$NEWLINE

// e2: RORR 2 by C=1 = 1. RORR1 would set C = old bit 0 = 0; RORR keeps 1:
// 0110.
SETR D 2
CALL PRE_SC:
RORR D D C
CALL PFLAGS:
$TXR D
$NEWLINE

// e3: ROLR1 1 = 2, C = old bit 63 = 0 (written), Z = 0, S kept 1: 0100.
SETR D 1
CALL PRE_SC:
ROLR1 D
CALL PFLAGS:
$TXR D
$NEWLINE

// e4: RORR1 1 = 0x8000_0000_0000_0000, C = old bit 0 = 1, Z = 0: 0010.
SETR D 1
CALL PRE_Z:
RORR1 D
CALL PFLAGS:
CALL TXHI:

// e5: ROLR 0 by C=1 = 0: Z written 1, C kept 1: 1110.
SETR D 0
CALL PRE_SC:
ROLR D D C
CALL PFLAGS:
$TXR D
$NEWLINE

// ===== f) F-bit Z writes on class-5 unary ops ==============================
// RTL (pc:516-539): NEG, NOT, BSWAP, BITREV, POPCNT, CLZ, CTZ, COPY write Z
// only when F (op[19]) is set; SEXT writes Z and S with F (S = result[63],
// pc:1078); ZEXT writes Z with F; INC/DEC require F and write all four
// (ALU +/-1, pc:537-539). The assembler sets F on NEGR, NOTR, ABSR, SEXTB,
// SEXTH, ZEXTB, ZEXTH, POPCNT, INCR, DECR, and not on COPY, CLZ.

// f1: COPY 0 (no F): Z kept 0 from PRE_SC: 0110.
SETR B 0
CALL PRE_SC:
COPY D B
CALL PFLAGS:

// f2: NEGR 0 = 0 (pc:1058): Z = 1, and no C/S/V (a SUB 0-0 would clear C):
// 1110.
SETR D 0
CALL PRE_SC:
NEGR D
CALL PFLAGS:

// f3: NOTR 0 = all ones (pc:1059): Z = 0; S not written (kept 0): 0000.
SETR D 0
CALL PRE_Z:
NOTR D
CALL PFLAGS:
$TXR D
$NEWLINE

// f4: SEXTB 0x80 = 0xFFFF_FFFF_FFFF_FF80 (pc:1064): Z = 0, S = 1: 0100.
SETR D 0x80
CALL PRE_Z:
SEXTB D
CALL PFLAGS:
$TXR D
$NEWLINE

// f5: SEXTH 0x17FFF = 0x7FFF: Z = 0, S = 0 (written), C kept 1: 0010.
SETR D 0x17FFF
CALL PRE_SC:
SEXTH D
CALL PFLAGS:
$TXR D
$NEWLINE

// f6: ZEXTB 0x100 = 0 (pc:1067): Z = 1, S kept 1: 1110.
SETR D 0x100
CALL PRE_SC:
ZEXTB D
CALL PFLAGS:
$TXR D
$NEWLINE

// f7: ZEXTH -1 = 0xFFFF: Z = 0: 0000.
SETR D -1
CALL PRE_Z:
ZEXTH D
CALL PFLAGS:
$TXR D
$NEWLINE

// f8: POPCNT 0 = 0 (pc:1073): Z = 1: 1110.
SETR D 0
CALL PRE_SC:
POPCNT D
CALL PFLAGS:

// f9: CLZ 0 = 64 (no F, pc:929-931): Z kept 1: 1000.
SETR D 0
CALL PRE_Z:
CLZ D
CALL PFLAGS:
$TXR D
$NEWLINE

// f10: INCR 0x7FFF_FFFF_FFFF_FFFF = 0x8000_0000_0000_0000 (ADD 1,
// pc:1012-1017): Z = 0, S = 1, C = sum[64] = 0, V = 1: 0101.
SETR64 D 0x7FFFFFFFFFFFFFFF
CALL PRE_Z:
INCR D
CALL PFLAGS:
CALL TXHI:

// ===== g) Unaligned 64-bit RAM access with A=0 =============================
// RTL: a 64-bit load or store with A=0 issues its address unaligned
// (pc:1112-1113 stores, pc:1185 loads), and takes or writes the whole
// doubleword (pc:1370 load data = m_rdata; pc:1114 be = 0xFF). The data
// cache selects the doubleword by addr[4:3] and ignores addr[2:0]
// (mem_read_write.sv:270-277), so the access reaches the aligned
// doubleword that holds the address. A byte-exact access would give
// different values (g1: low 33333333, high 00000000).
// The buffer is at 0x0020_0000 (2 MiB), far from this program's code.
SETR B 0x00200000
SETR64 C 0x1111111122222222
MEMSET64 C B
SETR64 C 0x3333333344444444
STIDX64A C B 8
SETR C 0
STIDX64A C B 16
SETR64 C 0x5555555566666666
STIDX64A C B 24

// g1: LDIDX64 at buf+0x0C (A=0, pc:549-562) reads the doubleword at buf+0x08.
LDIDX64 D B 0x0C
$TXR D
$NEWLINE
CALL TXHI:

// g2: MEMSET64RR (A=0) to buf+0x14 writes the doubleword at buf+0x10; the
// one at buf+0x18 is not touched.
SETR64 E 0x7777777788888888
ADDI F B 0x14
MEMSET64RR E F
LDIDX64A D B 16
$TXR D
$NEWLINE
CALL TXHI:
LDIDX64A D B 24
$TXR D
$NEWLINE
CALL TXHI:

// g3: MEMREADRR (A=0) at buf+0x04 reads the doubleword at buf+0x00.
ADDI F B 4
MEMREADRR D F
$TXR D
$NEWLINE

// ===== h) BEXTR and BDEP ===================================================
// RTL: start = imm[4:0], len = imm[12:8]. BEXTR (pc:1083-1088): result =
// zero-extended ((rs1 >> start) & mask) with rs1 the full 64 bits, and Z
// is always written (fmask.zero, pc:501-503). BDEP (pc:1089-1094):
// mask = ((0xFFFFFFFF >> (32-len)) << start) in 32 bits, result =
// zero-extended (rs1[31:0] & ~mask) | ((rs2[31:0] << start) & mask); no
// flags (pc:504-506).

// h1: rs1 = 0x0000_00A5_0000_0000, start 28 len 12 (imm 0x0C1C): bits
// 39..28 = 0xA50. Z = 0 written over PRE_Z's 1: 0000.
SETR64 B 0x000000A500000000
CALL PRE_Z:
BEXTR D B 0x0C1C
CALL PFLAGS:
$TXR D
$NEWLINE

// h2: start 0 len 8 of the same rs1 = 0: Z = 1 written: 1110.
CALL PRE_SC:
BEXTR D B 0x0800
CALL PFLAGS:

// h3: BDEP rs1 = -1, rs2 = 0, start 4 len 8 (imm 0x0804): mask 0xFF0,
// result 0xFFFF_F00F zero-extended. No flags: Z kept 1: 1000.
SETR B -1
SETR C 0
CALL PRE_Z:
BDEP D B C 0x0804
CALL PFLAGS:
$TXR D
$NEWLINE
CALL TXHI:

// h4: BDEP rs1 = 0, rs2 = 0xAB, start 28 len 8 (imm 0x081C): the 32-bit
// mask is 0xF000_0000, so bits above 31 are dropped: 0xB000_0000.
SETR B 0
SETR C 0xAB
BDEP D B C 0x081C
$TXR D
$NEWLINE
CALL TXHI:

// ===== i) .S imm8 forms at their boundaries ================================
// RTL f_short_imm (pc:754-770): class 2 sign-extends the byte when SGN
// op[20] is set (SETR.S, ADDI.S) and zero-extends it otherwise (ADDV.S,
// MINUSV.S, ANDV.S, ORV.S, XORV.S), pc:761; class 3 (CMPRV.S) always
// sign-extends, pc:762. The 32-bit value widens to 64 bits by the same SGN
// bit (pc:959 for SETR, pc:1951-1954 and 2007 for the ALU operand).

// i1: SETR.S -128 = 0xFFFF_FFFF_FFFF_FF80.
SETR.S D -128
$TXR D
$NEWLINE
CALL TXHI:

// i2: SETR.S 127 = 0x7F.
SETR.S D 127
$TXR D
$NEWLINE

// i3: ANDV.S 255 of -1 = 0xFF, zero-extended (sign-extended would give -1).
SETR D -1
ANDV.S D 255
$TXR D
$NEWLINE
CALL TXHI:

// i4: XORV.S 0 leaves 0x1234.
SETR D 0x1234
XORV.S D 0
$TXR D
$NEWLINE

// i5: ADDI.S 0x100 + -128 = 0x80; 0x100 + 127 = 0x17F.
SETR B 0x100
ADDI.S D B -128
$TXR D
$NEWLINE
ADDI.S D B 127
$TXR D
$NEWLINE

// i6: MINUSV.S 0x100 - 255 = 1; ADDV.S 1 + 255 = 0x100.
SETR D 0x100
MINUSV.S D 255
$TXR D
$NEWLINE
ADDV.S D 255
$TXR D
$NEWLINE

// i7: CMPRV.S -128 with D = -128: equal, Z = 1, C = 0 (no borrow), S = V = 0:
// 1000. (A zero-extended 128 would give Z = 0.)
SETR.S D -128
CALL PRE_SC:
CMPRV.S D -128
CALL PFLAGS:

// i8: CMPRV.S 127 with D = -128: 0xFFFF_FFFF_FFFF_FF80 - 0x7F =
// 0xFFFF_FFFF_FFFF_FF01: Z = 0, S = 1, no borrow so C = 0, V = 0
// (pc:1016): 0100.
CALL PRE_Z:
CMPRV.S D 127
CALL PFLAGS:

// ===== j) A #name string ===================================================
// #name "text" is a C string: characters in memory order, then a NUL. Byte
// loads take lane addr[2:0] of the doubleword (pc:1343, 1367); MEMGET32
// (U_LOAD32, pc:560) at offset 0 takes bytes 0-3 little-endian (pc:1349).
SETR A #HWSTR
$TXSTR A
$NEWLINE
MEMGET8 D A
$TXR D
$NEWLINE
LDIDX8 D A 7
$TXR D
$NEWLINE
LDIDX8 D A 8
$TXR D
$NEWLINE
MEMGET32 D A
$TXR D
$NEWLINE

// ===== k) Code after inline data ==========================================
// LEAPC (2 words) + NOP + JMP (2 words) = 20 bytes, so the JMP ends 4 bytes
// past an 8-byte boundary (the NOP is there to make it so) and the
// assembler pads 4 zero bytes before #KDATA. #KDATA ("1D1EC0DE" and its NUL
// in 16 bytes) is then 8-aligned, and so is K_RESUME after it. The jump
// skips the pad and the data, and the code after them runs.
// E = the LEAPC's address (pc:1080, ex_pc + 0), so #KDATA - E = 20 + the
// 4-byte pad = 0x18. If code above is changed and this prints 0x14 (no
// pad), add or remove a NOP before the LEAPC.
LEAPC E 0
NOP
JMP K_RESUME:
#KDATA "1D1EC0DE"
K_RESUME:
SETR A #KDATA
$TXSTR A
$NEWLINE
SETR D #KDATA
SUBR D D E
$TXR D
$NEWLINE
SETR D #KDATA
ANDV D 7
$TXR D
$NEWLINE
SETR D K_RESUME:
ANDV D 7
$TXR D
$NEWLINE

HALT

// ===== Helpers =============================================================
// PRE_Z: CMP 5 - 5 = 0: Z = 1, S = 0, C = 0, V = 0. Uses K. CALL and RET
// write no flags: neither decode sets fmask (pc:568-581, 619-622).
PRE_Z:
SETR K 5
CMPRR K K
RET

// PRE_SC: CMP 1 - 2: 65-bit difference 0x1_FFFF_FFFF_FFFF_FFFF, so C = 1
// (borrow), S = 1, Z = 0, V = 0 (signs equal). Uses K, L.
PRE_SC:
SETR K 1
SETR L 2
CMPRR K L
RET

// PFLAGS: print the flags as 0000ZSCV. Uses N, O, P.
// GETF (SETFR, F clear, so it writes no flags, pc:532-535) gives
// {Z, Z, C, V, 60'b0} (pc:1076). S is not in GETF: JMPNS reads it
// (cond 4 inverted, klauss_pkg.sv:373). The shifts after the capture write Z,
// which no longer matters.
PFLAGS:
SETFR P
SETR O 0
JMPNS PFLAGS_NS:
SETR O 0x100
PFLAGS_NS:
SHRV P 60
COPY N P
SHRV N 3
SHLV N 12
ORR O O N
COPY N P
ANDV N 2
SHLV N 3
ORR O O N
ANDV P 1
ORR O O P
$TXR O
$NEWLINE
RET

// TXHI: print D[63:32]. Uses O.
TXHI:
COPY O D
SHRV O 32
$TXR O
$NEWLINE
RET

#HWSTR "C0FFEE42"

// v2 MMIO UART output helpers ($TXR / $NEWLINE / $TXSTR / $TXMEMCHAR)
!include uart_stubs.kla
