// String print subroutine
// Input: A = pointer to null-terminated string in memory
// Uses: A (pointer), B (character read)
// Prints each character with $TXMEMCHAR until a zero byte is found.

STRING_PRINT:
MEMGET8 B A            // B = mem8[A] (read character)
CMPRV B 0x0            // compare B to null terminator
JMPE STRING_DONE:      // if zero, done
$TXMEMCHAR A  // send character at mem[A]
INCR A                 // advance pointer
JMP STRING_PRINT:      // loop

STRING_DONE:
RET

// v2 MMIO UART output helpers ($TXR / $NEWLINE / $TXSTR / $TXMEMCHAR)
!include uart_stubs.kla
