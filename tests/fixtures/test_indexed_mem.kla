// Test: indexed 64-bit memory (base + immediate offset, base + register offset).
// 64-bit loads/stores are 8-byte aligned, so array elements are one doubleword
// (8 bytes) apart. Offsets 0, 8, 16 address distinct slots.
// Expected UART output:
//   000000AA  (STIDX64/LDIDX64: store 0xAA at base+0, load back)
//   000000BB  (STIDX64/LDIDX64: store 0xBB at base+8, load back)
//   000000CC  (STIDX64R/LDIDX64R: register-offset store and load at base+16)
//   000000BB  (LDIDX64: verify base+8 still intact after the base+16 write)

_start
DELAYV 0x0500
$NEWLINE

SETR A #ARRAY

// slot 0 (base + 0)
SETR B 0xAA
STIDX64 B A 0x0
SETR D 0x0
LDIDX64 D A 0x0
$TXR D  // Expect: 000000AA
$NEWLINE

// slot 1 (base + 8)
SETR B 0xBB
STIDX64 B A 0x8
SETR D 0x0
LDIDX64 D A 0x8
$TXR D  // Expect: 000000BB
$NEWLINE

// slot 2 (base + register offset 16)
SETR C 0x10
SETR B 0xCC
STIDX64R B A C
SETR D 0x0
LDIDX64R D A C
$TXR D  // Expect: 000000CC
$NEWLINE

// verify slot 1 (base + 8) survived the slot-2 write
SETR D 0x0
LDIDX64 D A 0x8
$TXR D  // Expect: 000000BB
$NEWLINE

HALT
#ARRAY 32
!include uart_stubs.kla
