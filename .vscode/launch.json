{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug executable 'klausscc'",
            "cargo": {
                "args": [
                    "build",
                    "--bin=klausscc",
                    "--package=klausscc"
                ],
                "filter": {
                    "name": "klausscc",
                    "kind": "bin"
                }
            },
            // Add "-s" (or "-s", "/dev/ttyUSB1") to also send the program to the board.
            "args": ["-i", "tests/fixtures/v2_hello.kla"],
            "cwd": "${workspaceFolder}",
            "env": { "RUST_BACKTRACE": "full" }
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug unit tests in library 'klausscc'",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--lib",
                    "--package=klausscc"
                ],
                "filter": {
                    "name": "klausscc",
                    "kind": "lib"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "env": { "RUST_BACKTRACE": "full" }
        }
    ]
}
