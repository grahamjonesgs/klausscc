// Built from: tests/demo.c
// Generated by build.sh
//

// ========== Runtime startup ==========
_start
SETR P 0xFFFFF
COPY O P
DELAYV 0x0500
CALL main:
$TXR M
$NEWLINE
HALT

// ========== C library (register calling convention) ==========
// Rewritten for the ISA-v2 toolchain: args in A (and B), result in M — the
// same convention main/factorial/gcd/is_prime already use. The previous
// bundled libc read its args from the stack frame, which no caller here sets
// up, so every string/number print walked garbage. Character output goes
// through the shared MMIO helpers in uart_stubs.kla (TX_CHAR / TX_NL).
//
// String data is one character per .word (the char sits in byte 0, so words
// are 8 bytes apart); print_str walks them with MEMGET8 and an 8-byte stride.

// putchar(A): transmit A's low byte
putchar:
CALL TX_CHAR:
RET

// print_str(A): print the .word string at address A, stopping at the NUL word
print_str:
PUSH A
PUSH B
COPY B A
print_str_loop:
MEMGET8 A B            // A = next character (byte 0 of the word)
CMPRV A 0
JMPE print_str_done:
CALL TX_CHAR:
ADDV B 8              // advance to the next .word character
JMP print_str_loop:
print_str_done:
POP B
POP A
RET

// newline(): print a line feed
newline:
CALL TX_NL:
RET

// print_unsigned(A): print A as unsigned decimal (recurses for the high digits)
print_unsigned:
PUSH B
PUSH C
CMPRV A 10
JMPLT print_unsigned_ones:
COPY C A
SETR B 10
DIVUR A A B            // A = A / 10
CALL print_unsigned:
COPY A C              // restore this frame's value
print_unsigned_ones:
SETR B 10
MODUR A A B            // A = A % 10
ADDV A 0x30          // '0' + digit
CALL TX_CHAR:
POP C
POP B
RET

// print_int(A): print A as signed decimal
print_int:
CMPRV A 0
JMPGE print_int_pos:
PUSH A
SETR A 0x2D          // '-'
CALL TX_CHAR:
POP A
NEGR A
print_int_pos:
CALL print_unsigned:
RET

// ========== User program ==========
factorial:
MEMSET64RR O P
DECR P
COPY O P
MINUSV P 2
STIDX64 G O 0xFFFFFFFF
STIDX64 H O 0xFFFFFFFE
SETR G 1
SETR H 2
JMP LX_5:
LX_2:
MULR G G H
LX_3:
SETR M 1
ADDR H H M
LX_5:
CMPRR H A
JMPLE LX_2:
COPY M G
LX_1:
LDIDX64 G O 0xFFFFFFFF
LDIDX64 H O 0xFFFFFFFE
COPY P O
INCR P
MEMREADRR O P
RET
gcd:
MEMSET64RR O P
DECR P
COPY O P
MINUSV P 1
STIDX64 H O 0xFFFFFFFF
JMP LX_8:
LX_7:
COPY H B
COPY N B
COPY B A
MODR B B N
COPY A H
LX_8:
SETR M 0
CMPRR B M
JMPNE LX_7:
COPY M A
LX_6:
LDIDX64 H O 0xFFFFFFFF
COPY P O
INCR P
MEMREADRR O P
RET
is_prime:
MEMSET64RR O P
DECR P
COPY O P
MINUSV P 1
STIDX64 H O 0xFFFFFFFF
SETR M 1
CMPRR A M
JMPGT LX_11:
SETR M 0
JMP LX_10:
LX_11:
SETR M 3
CMPRR A M
JMPGT LX_13:
SETR M 1
JMP LX_10:
LX_13:
SETR H 2
JMP LX_16:
LX_15:
COPY M A
MODR M M H
SETR L 0
CMPRR M L
JMPNE LX_18:
SETR M 0
JMP LX_10:
LX_18:
SETR M 1
ADDR H H M
LX_16:
COPY M H
MULR M M H
CMPRR M A
JMPLE LX_15:
SETR M 1
LX_10:
LDIDX64 H O 0xFFFFFFFF
COPY P O
INCR P
MEMREADRR O P
RET
