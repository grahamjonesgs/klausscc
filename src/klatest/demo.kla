// ========== UART output helpers ==========
// Shared ISA-v2 MMIO routines: TX_CHAR (raw byte), TX_NL (newline),
// TX_HEX32 (8 hex digits), TX_STR (packed byte string), plus the
// $TXR / $NEWLINE / $TXCHAR / $TXSTR macros used above. Include last so
// the subroutines are never reached by fall-through.
!include uart_stubs.kla
