// C-to-assembly test: compute and print results via UART
// Expected output:
//   0000002A  (6*7 = 42)
//   00000078  (5! = 120)
//   00000006  (gcd(48,18) = 6)
//   00000022  (fib(9) = 34 (64-bit iterative))
//   00000001  (is_prime(17) = 1)
//   00000000  (is_prime(18) = 0)
//

_start
SETR P 0xFFFFF
COPY O P
DELAYV 0x0500
$NEWLINE

// Test 1: multiply(6, 7) = 42
SETR A 6
SETR B 7
CALL multiply:
$TXR M
$NEWLINE

// Test 2: factorial(5) = 120
SETR A 5
CALL factorial:
$TXR M
$NEWLINE

// Test 3: gcd(48, 18) = 6
SETR A 48
SETR B 18
CALL gcd:
$TXR M
$NEWLINE

// Test 4: fibonacci(9) = 55
SETR A 9
CALL fibonacci:
$TXR M
$NEWLINE

// Test 5: is_prime(17) = 1
SETR A 17
CALL is_prime:
$TXR M
$NEWLINE

// Test 6: is_prime(18) = 0
SETR A 18
CALL is_prime:
$TXR M
$NEWLINE

HALT

// ========== Compiled C functions ==========
multiply:
MEMSET64RR O P
DECR P
COPY O P
COPY M A
MULR M M B
L_1:
COPY P O
INCR P
MEMREADRR O P
RET
factorial:
MEMSET64RR O P
DECR P
COPY O P
MINUSV P 4
STIDX64 G O 0xFFFFFFFF
STIDX64 H O 0xFFFFFFFE
SETR G 1
SETR H 2
JMP L_6:
L_3:
MULR G G H
L_4:
SETR M 1
ADDR H H M
L_6:
CMPRR H A
JMPLE L_3:
COPY M G
L_2:
LDIDX64 G O 0xFFFFFFFF
LDIDX64 H O 0xFFFFFFFE
COPY P O
INCR P
MEMREADRR O P
RET
gcd:
MEMSET64RR O P
DECR P
COPY O P
MINUSV P 4
STIDX64 H O 0xFFFFFFFF
JMP L_9:
L_8:
COPY H B
COPY N B
COPY B A
MODR B B N
COPY A H
L_9:
SETR M 0
CMPRR B M
JMPNE L_8:
COPY M A
L_7:
LDIDX64 H O 0xFFFFFFFF
COPY P O
INCR P
MEMREADRR O P
RET
fibonacci:
MEMSET64RR O P
DECR P
COPY O P
MINUSV P 4
STIDX64 E O 0xFFFFFFFF
STIDX64 F O 0xFFFFFFFE
STIDX64 G O 0xFFFFFFFD
STIDX64 H O 0xFFFFFFFC
SETR M 0
COPY F M
SETR H 1
COPY G M
JMP L_15:
L_12:
COPY E F
ADDR E E H
COPY F H
COPY H E
L_13:
SETR M 1
ADDR G G M
L_15:
CMPRR G A
JMPLT L_12:
COPY M F
L_11:
LDIDX64 E O 0xFFFFFFFF
LDIDX64 F O 0xFFFFFFFE
LDIDX64 G O 0xFFFFFFFD
LDIDX64 H O 0xFFFFFFFC
COPY P O
INCR P
MEMREADRR O P
RET
is_prime:
MEMSET64RR O P
DECR P
COPY O P
MINUSV P 4
STIDX64 H O 0xFFFFFFFF
SETR M 1
CMPRR A M
JMPGT L_17:
SETR M 0
JMP L_16:
L_17:
SETR M 3
CMPRR A M
JMPGT L_19:
SETR M 1
JMP L_16:
L_19:
SETR H 2
JMP L_22:
L_21:
COPY M A
MODR M M H
SETR L 0
CMPRR M L
JMPNE L_24:
SETR M 0
JMP L_16:
L_24:
SETR M 1
ADDR H H M
L_22:
COPY M H
MULR M M H
CMPRR M A
JMPLE L_21:
SETR M 1
L_16:
LDIDX64 H O 0xFFFFFFFF
COPY P O
INCR P
MEMREADRR O P
RET

// v2 MMIO UART output helpers ($TXR / $NEWLINE / $TXSTR / $TXMEMCHAR)
!include uart_stubs.kla
