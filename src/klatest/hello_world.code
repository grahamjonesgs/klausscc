                              -- 
                              -- // v2 MMIO UART output helpers ($TXR / $NEWLINE / $TXSTR / $TXMEMCHAR)
                              -- // Shared ISA-v2 UART output helpers (MMIO), replacing the retired v1 print
                              -- // opcodes (TXR / NEWLINE / TXCHARMEMR / TXSTRMEMR). UART is memory-mapped:
                              -- // TX_DATA lives at 0xF0010000 and a byte store transmits data[7:0].
                              -- //
                              -- // Every routine preserves ALL general-purpose registers (A..P) it does not
                              -- // take as an argument, so it is a drop-in replacement for the single-opcode v1
                              -- // primitives. Include this file at the END of a program (after HALT) so the
                              -- // subroutines are never reached by fall-through:  !include uart_stubs.kla
                              -- //
                              -- // Calling convention (see the $TXR / $NEWLINE / $TXCHAR / $TXSTR macros):
                              -- //   TX_HEX32 : prints reg A's low 32 bits as 8 uppercase hex digits.
                              -- //   TX_NL    : prints a newline (0x0A).
                              -- //   TX_CHAR  : prints reg A's low byte as a raw character.
                              -- //   TX_STR   : prints the NUL-terminated string at address reg A.
                              -- 
                              -- // --- TX_HEX32: print A[31:0] as 8 uppercase hex digits -----------------------
0x00000340:                   -- TX_HEX32:
0x00000340: 64000010          -- PUSH B
0x00000344: 64000020          -- PUSH C
0x00000348: 64000030          -- PUSH D
0x0000034C: 64000040          -- PUSH E
0x00000350: 8BD00100 F0010000 -- SETR B 0xF0010000        // UART TX_DATA
0x00000358: 8BD00200 0000001C -- SETR C 28                // shift for the most-significant nibble of the low word
0x00000360:                   -- TX_HEX32_LOOP:
0x00000360: 50404302          -- SHRR D A C               // D = A >> C  (count = C[5:0])
0x00000364: 89000330 0000000F -- ANDV D 0xF               // D = current nibble
0x0000036C: 8C100030 0000000A -- CMPRV D 10               // flags from D - 10 (signed)
0x00000374: A0280000 0000038C -- JMPLT TX_HEX32_DEC:      // 0-9 -> decimal digit
0x0000037C: 88200330 00000037 -- ADDV D 0x37              // 10-15 -> 'A'..'F'
0x00000384: A0000000 00000394 -- JMP TX_HEX32_PUT:
0x0000038C:                   -- TX_HEX32_DEC:
0x0000038C: 88200330 00000030 -- ADDV D 0x30              // '0'..'9'
0x00000394:                   -- TX_HEX32_PUT:
0x00000394: 5C000310          -- MEMSET8 D B              // transmit the character (data = D, address = B)
0x00000398: 8BD00400 00000004 -- SETR E 4
0x000003A0: 44600224          -- SUBR C C E               // next nibble
0x000003A4: 8C100020 00000000 -- CMPRV C 0                // flags from C - 0 (signed)
0x000003AC: A02C0000 00000360 -- JMPGE TX_HEX32_LOOP:     // repeat while C >= 0
0x000003B4: 64800400          -- POP E
0x000003B8: 64800300          -- POP D
0x000003BC: 64800200          -- POP C
0x000003C0: 64800100          -- POP B
0x000003C4: 65800000          -- RET
