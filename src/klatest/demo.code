                              -- 
                              -- // ========== UART output helpers ==========
                              -- // Shared ISA-v2 MMIO routines: TX_CHAR (raw byte), TX_NL (newline),
                              -- // TX_HEX32 (8 hex digits), TX_STR (packed byte string), plus the
                              -- // $TXR / $NEWLINE / $TXCHAR / $TXSTR macros used above. Include last so
                              -- // the subroutines are never reached by fall-through.
                              -- // Shared ISA-v2 UART output helpers (MMIO), replacing the retired v1 print
                              -- // opcodes (TXR / NEWLINE / TXCHARMEMR / TXSTRMEMR). UART is memory-mapped:
                              -- // TX_DATA lives at 0xF0010000 and a byte store transmits data[7:0].
                              -- //
                              -- // Every routine preserves ALL general-purpose registers (A..P) it does not
                              -- // take as an argument, so it is a drop-in replacement for the single-opcode v1
                              -- // primitives. Include this file at the END of a program (after HALT) so the
                              -- // subroutines are never reached by fall-through:  !include uart_stubs.kla
                              -- //
                              -- // Calling convention (see the $TXR / $NEWLINE / $TXCHAR / $TXSTR macros):
                              -- //   TX_HEX32 : prints reg A's low 32 bits as 8 uppercase hex digits.
                              -- //   TX_NL    : prints a newline (0x0A).
                              -- //   TX_CHAR  : prints reg A's low byte as a raw character.
                              -- //   TX_STR   : prints the NUL-terminated string at address reg A.
                              -- 
                              -- // --- TX_HEX32: print A[31:0] as 8 uppercase hex digits -----------------------
0x00000760:                   -- TX_HEX32:
0x00000760: 64000010          -- PUSH B
0x00000764: 64000020          -- PUSH C
0x00000768: 64000030          -- PUSH D
0x0000076C: 64000040          -- PUSH E
0x00000770: 8BD00100 F0010000 -- SETR B 0xF0010000        // UART TX_DATA
0x00000778: 8BD00200 0000001C -- SETR C 28                // shift for the most-significant nibble of the low word
0x00000780:                   -- TX_HEX32_LOOP:
0x00000780: 50404302          -- SHRR D A C               // D = A >> C  (count = C[5:0])
0x00000784: 89000330 0000000F -- ANDV D 0xF               // D = current nibble
0x0000078C: 8C100030 0000000A -- CMPRV D 10               // flags from D - 10 (signed)
0x00000794: A0280000 000007AC -- JMPLT TX_HEX32_DEC:      // 0-9 -> decimal digit
0x0000079C: 88200330 00000037 -- ADDV D 0x37              // 10-15 -> 'A'..'F'
0x000007A4: A0000000 000007B4 -- JMP TX_HEX32_PUT:
0x000007AC:                   -- TX_HEX32_DEC:
0x000007AC: 88200330 00000030 -- ADDV D 0x30              // '0'..'9'
0x000007B4:                   -- TX_HEX32_PUT:
0x000007B4: A2000000 000008B0 -- CALL TX_WAIT_READY:      // block until the transmitter is idle (avoids UART overrun)
0x000007BC: 5C000310          -- MEMSET8 D B              // transmit the character (data = D, address = B)
0x000007C0: 8BD00400 00000004 -- SETR E 4
0x000007C8: 44600224          -- SUBR C C E               // next nibble
