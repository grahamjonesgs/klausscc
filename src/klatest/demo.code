0x00000864: 8BD00200 F0010000 -- SETR C 0xF0010000        // UART TX_DATA
0x0000086C: 54000300          -- COPY D A                 // D = current byte address
0x00000870:                   -- TX_STR_LOOP:
0x00000870: 58000130          -- MEMGET8 B D              // B = mem8[D]
0x00000874: 8C100010 00000000 -- CMPRV B 0                // stop at the NUL terminator
0x0000087C: A0480000 0000089C -- JMPE TX_STR_DONE:
0x00000884: A2000000 000008B0 -- CALL TX_WAIT_READY:      // block until the transmitter is idle (avoids UART overrun)
0x0000088C: 5C000120          -- MEMSET8 B C              // transmit byte
0x00000890: 57880330          -- INCR D                   // advance
0x00000894: A0000000 00000870 -- JMP TX_STR_LOOP:
0x0000089C:                   -- TX_STR_DONE:
0x0000089C: 64800300          -- POP D
0x000008A0: 64800200          -- POP C
0x000008A4: 64800100          -- POP B
0x000008A8: 64800000          -- POP A
0x000008AC: 65800000          -- RET
                              -- 
                              -- // --- TX_WAIT_READY: spin until the UART transmitter is no longer busy --------
                              -- // Mirrors uart_tx_byte() in the C runtime (mmio.h): poll STATUS (0xF0010010)
                              -- // and loop while TX_BUSY (bit 0) is set, so a store to TX_DATA never clobbers a
                              -- // byte still being shifted out. Preserves every register (A/B saved & restored).
                              -- // The emulator models instant transmit (TX_BUSY always 0), so this returns
                              -- // immediately there and only actually waits on real hardware.
0x000008B0:                   -- TX_WAIT_READY:
0x000008B0: 64000000          -- PUSH A
0x000008B4: 64000010          -- PUSH B
0x000008B8: 8BD00100 F0010010 -- SETR B 0xF0010010        // UART STATUS
0x000008C0:                   -- TX_WAIT_READY_LOOP:
0x000008C0: 58000010          -- MEMGET8 A B              // A = STATUS[7:0]
0x000008C4: 89000000 00000001 -- ANDV A 0x1               // isolate TX_BUSY (bit 0)
0x000008CC: 8C100000 00000000 -- CMPRV A 0
0x000008D4: A04C0000 000008C0 -- JMPNE TX_WAIT_READY_LOOP // still transmitting -> keep spinning
0x000008DC: 64800100          -- POP B
0x000008E0: 64800000          -- POP A
0x000008E4: 65800000          -- RET
